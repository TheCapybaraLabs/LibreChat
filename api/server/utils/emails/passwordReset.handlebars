<!DOCTYPE html>
<html lang='pt-BR'>

  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='x-apple-disable-message-reformatting' />
    <meta name='color-scheme' content='light only' />
    <meta name='supported-color-schemes' content='light only' />
    <title>{{appName}}</title>
    <!--[if gte mso 9]>
    <xml>
      <o:OfficeDocumentSettings>
        <o:AllowPNG />
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
    <![endif]-->
    <style type='text/css'>
      :root { color-scheme: light only; supported-color-schemes: light only; }
      @media (prefers-color-scheme: dark) {
        .lb-outer { background-color: #f4f5f7 !important; }
        .lb-card { background-color: #ffffff !important; color: #1f2328 !important; }
        .lb-divider { border-color: #eef0f3 !important; }
        .lb-brand, .lb-link { color: #10a37f !important; }
        .lb-heading { color: #0f172a !important; }
        .lb-body { color: #334155 !important; }
        .lb-dim { color: #475569 !important; }
        .lb-footer { color: #64748b !important; }
        .lb-warn-card { background-color: #fff7ed !important; border-color: #fed7aa !important; }
        .lb-warn-text { color: #9a3412 !important; }
      }
      [data-ogsb] .lb-outer { background-color: #f4f5f7 !important; }
      [data-ogsb] .lb-card { background-color: #ffffff !important; }
      [data-ogsb] .lb-warn-card { background-color: #fff7ed !important; }
      [data-ogsc] .lb-heading { color: #0f172a !important; }
      [data-ogsc] .lb-body { color: #334155 !important; }
      [data-ogsc] .lb-dim { color: #475569 !important; }
      [data-ogsc] .lb-footer { color: #64748b !important; }
      [data-ogsc] .lb-warn-text { color: #9a3412 !important; }
      [data-ogsc] .lb-brand, [data-ogsc] .lb-link { color: #10a37f !important; }
    </style>
  </head>

  <body
    class='lb-outer'
    style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f4f5f7; color: #1f2328;"
  >
    <table
      role='presentation'
      class='lb-outer'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color: #f4f5f7; padding: 32px 16px;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            class='lb-card'
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);'
          >
            <tr>
              <td
                class='lb-divider'
                style='padding: 28px 32px 20px 32px; border-bottom: 1px solid #eef0f3;'
              >
                <div
                  class='lb-brand'
                  style='font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: #10a37f;'
                >
                  {{appName}}
                </div>
              </td>
            </tr>

            <tr>
              <td style='padding: 32px;'>
                <h1
                  class='lb-heading'
                  style='margin: 0 0 20px 0; font-size: 22px; line-height: 1.35; font-weight: 600; color: #0f172a; letter-spacing: -0.01em;'
                >
                  Sua senha foi atualizada.
                </h1>

                <p
                  class='lb-body'
                  style='margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #334155;'
                >Olá
                  {{name}},</p>

                <p
                  class='lb-body'
                  style='margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #334155;'
                >Confirmamos que a senha da sua conta no
                  {{appName}}
                  foi redefinida com sucesso. Você já pode entrar usando a nova
                  senha.</p>

                <table
                  role='presentation'
                  class='lb-warn-card'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin: 0 0 24px 0; background-color: #fff7ed; border: 1px solid #fed7aa; border-radius: 8px;'
                >
                  <tr>
                    <td style='padding: 14px 18px;'>
                      <div
                        class='lb-warn-text'
                        style='font-size: 13px; line-height: 1.5; color: #9a3412;'
                      >Não foi você?
                        {{#if supportEmail}}Escreva para
                          <a
                            href='mailto:{{supportEmail}}'
                            class='lb-warn-text'
                            style='color: #9a3412; text-decoration: underline;'
                          >{{supportEmail}}</a>
                          imediatamente para proteger sua conta.{{else}}Altere
                          sua senha novamente imediatamente para proteger sua
                          conta.{{/if}}</div>
                    </td>
                  </tr>
                </table>

                {{#if supportEmail}}
                  <p
                    class='lb-body'
                    style='margin: 0; font-size: 15px; line-height: 1.6; color: #334155;'
                  >Qualquer outra dúvida, é só responder para
                    <a
                      href='mailto:{{supportEmail}}'
                      class='lb-link'
                      style='color: #10a37f; text-decoration: underline;'
                    >{{supportEmail}}</a>.</p>
                {{/if}}
              </td>
            </tr>

            <tr>
              <td
                class='lb-divider'
                style='padding: 20px 32px 28px 32px; border-top: 1px solid #eef0f3;'
              >
                <p
                  class='lb-dim'
                  style='margin: 0 0 4px 0; font-size: 13px; line-height: 1.5; color: #475569;'
                >Atenciosamente,<br />Equipe
                  {{appName}}</p>
                <p
                  class='lb-footer'
                  style='margin: 12px 0 0 0; font-size: 12px; line-height: 1.5; color: #64748b;'
                >©
                  {{year}}
                  {{appName}}. Todos os direitos reservados.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>

</html>
