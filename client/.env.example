# VITE_THEME_LIGHT_ACCENT_FOREGROUND=0 0% 9%
# VITE_THEME_LIGHT_DESTRUCTIVE_FOREGROUND=0 0% 98%
# VITE_THEME_LIGHT_BORDER=0 0% 89.8%
# VITE_THEME_LIGHT_INPUT=0 0% 89.8%
# VITE_THEME_LIGHT_RING=0 0% 3.9%

