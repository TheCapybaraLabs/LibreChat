# Example Vite env file for the client
# Copy to `.env` or `.env.local` and set values for local development

# Enable debug logging (true/false)
VITE_ENABLE_LOGGER=true
# Filter for logger (supports comma-separated values or regex-like text)
VITE_LOGGER_FILTER=*

# Logos and image URLs (relative paths or absolute URLs)
VITE_CLIENT_BANNER=
VITE_PLATFORM_IMAGE=
VITE_DEV_LOGO=
VITE_APP_TITLE=LabsChat

# =============================================================================
# THEME CUSTOMIZATION (Optional)
# =============================================================================
# Customize the application theme colors using environment variables.
# All color values MUST be in space-separated RGB format: "R G B"
# Example: "255 255 255" for white, "0 0 0" for black
#
# You can define separate themes for light and dark modes by using:
# - VITE_THEME_LIGHT_* for light mode colors
# - VITE_THEME_DARK_* for dark mode colors
#
# If you only define one mode, the app will use CSS defaults for the other.
# =============================================================================

# -----------------------------------------------------------------------------
# LIGHT THEME COLORS
# -----------------------------------------------------------------------------
# Text Colors
# VITE_THEME_LIGHT_TEXT_PRIMARY=33 33 33
# VITE_THEME_LIGHT_TEXT_SECONDARY=66 66 66
# VITE_THEME_LIGHT_TEXT_SECONDARY_ALT=89 89 89
# VITE_THEME_LIGHT_TEXT_TERTIARY=89 89 89
# VITE_THEME_LIGHT_TEXT_WARNING=245 158 11

# Surface/Background Colors
# VITE_THEME_LIGHT_SURFACE_PRIMARY=255 255 255
# VITE_THEME_LIGHT_SURFACE_PRIMARY_ALT=247 247 248
# VITE_THEME_LIGHT_SURFACE_PRIMARY_CONTRAST=236 236 236
# VITE_THEME_LIGHT_SURFACE_SECONDARY=247 247 248
# VITE_THEME_LIGHT_SURFACE_SECONDARY_ALT=227 227 227
# VITE_THEME_LIGHT_SURFACE_TERTIARY=236 236 236
# VITE_THEME_LIGHT_SURFACE_TERTIARY_ALT=255 255 255
# VITE_THEME_LIGHT_SURFACE_ACTIVE=236 236 236
# VITE_THEME_LIGHT_SURFACE_ACTIVE_ALT=227 227 227
# VITE_THEME_LIGHT_SURFACE_HOVER=227 227 227
# VITE_THEME_LIGHT_SURFACE_HOVER_ALT=205 205 205
# VITE_THEME_LIGHT_SURFACE_DIALOG=255 255 255
# VITE_THEME_LIGHT_SURFACE_CHAT=255 255 255
# VITE_THEME_LIGHT_SURFACE_SUBMIT=185 28 28
# VITE_THEME_LIGHT_SURFACE_SUBMIT_HOVER=153 27 27
# VITE_THEME_LIGHT_SURFACE_DESTRUCTIVE=185 28 28
# VITE_THEME_LIGHT_SURFACE_DESTRUCTIVE_HOVER=153 27 27

# Border Colors
# VITE_THEME_LIGHT_BORDER_LIGHT=227 227 227
# VITE_THEME_LIGHT_BORDER_MEDIUM=205 205 205
# VITE_THEME_LIGHT_BORDER_MEDIUM_ALT=205 205 205
# VITE_THEME_LIGHT_BORDER_HEAVY=153 150 150
# VITE_THEME_LIGHT_BORDER_XHEAVY=89 89 89

# Header Colors
# VITE_THEME_LIGHT_HEADER_PRIMARY=255 255 255
# VITE_THEME_LIGHT_HEADER_HOVER=247 247 248
# VITE_THEME_LIGHT_HEADER_BUTTON_HOVER=247 247 248

# Other Colors
# VITE_THEME_LIGHT_RING_PRIMARY=89 89 89
# VITE_THEME_LIGHT_BRAND_PURPLE=171 104 255
# VITE_THEME_LIGHT_BRAND_BORDER=239 68 68
# VITE_THEME_LIGHT_BRAND_FOOTER=239 68 68
# VITE_THEME_LIGHT_BRAND_PRIMARY=220 38 38
# VITE_THEME_LIGHT_BRAND_PRIMARY_HOVER=185 28 28
# VITE_THEME_LIGHT_PRESENTATION=255 255 255

# Utility Colors (HSL format: "H S% L%")
# VITE_THEME_LIGHT_BACKGROUND=0 0% 100%
# VITE_THEME_LIGHT_FOREGROUND=0 0% 3.9%
# VITE_THEME_LIGHT_CARD=0 0% 100%
# VITE_THEME_LIGHT_CARD_FOREGROUND=0 0% 3.9%
# VITE_THEME_LIGHT_PRIMARY=0 0% 9%
# VITE_THEME_LIGHT_PRIMARY_FOREGROUND=0 0% 98%
# VITE_THEME_LIGHT_SECONDARY=0 0% 96.1%
