# Example 1: Blue theme for light mode only
# VITE_THEME_LIGHT_SURFACE_SUBMIT=37 99 235
# VITE_THEME_LIGHT_SURFACE_SUBMIT_HOVER=29 78 216
#
# Example 2: Green theme for both light and dark modes
# VITE_THEME_LIGHT_SURFACE_SUBMIT=21 128 61
# VITE_THEME_DARK_SURFACE_SUBMIT=34 197 94
#
# Example 3: Custom brand color
# VITE_THEME_LIGHT_BRAND_PURPLE=138 43 226
